{% for label, messages in app.flashes %}
    {% for message in messages %}
    <div class="container">
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show ms-auto" role="alert" style="max-width: 600px">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    </div>
{% endfor %}